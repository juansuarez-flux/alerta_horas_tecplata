# Redmine Agile MCP - Environment Variables
# Copy this file to .env and fill in your values

# Base URL of your Redmine instance (no trailing slash)
REDMINE_URL=https://your-redmine.example.com

# Your Redmine API key (found at /my/account)
REDMINE_API_KEY=your_api_key_here

# Optional: Output directory for generated executive reports (defaults to Downloads or OS temp dir)
# REPORTS_OUTPUT_DIR=C:\Users\username\Documents\Reportes

